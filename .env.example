# Guitar Junk Tracker — optional configuration.
# Copy to .env and adjust if you need to. Every value has a working default,
# so a plain `docker compose up -d --build` works with no .env at all.

# Port the app listens on (keep in sync with the ports mapping in compose).
# PORT=3131

# SQLite database file location.
# DATABASE_URL=file:/data/guitar-tracker.db

# Where uploaded photos are written.
# PHOTOS_DIR=/data/photos

# Public origin used in password-reset emails. Origin only: scheme + host
# [+ port], no path. Required when SMTP is configured; reset emails will fail
# rather than guess the URL from the request.
# Local dev:     APP_PUBLIC_ORIGIN=http://localhost:3000
# Docker:        APP_PUBLIC_ORIGIN=http://localhost:3131
# Reverse proxy: APP_PUBLIC_ORIGIN=https://gear.example.com
APP_PUBLIC_ORIGIN=http://localhost:3000

# Set to 1 when serving over HTTPS so session cookies are marked secure-only.
# COOKIE_SECURE=1

# Email of the user whose collection shows on the guest landing page.
# Defaults to the first admin created in the setup wizard.
# SHOWCASE_EMAIL=you@example.com

# Note: SMTP settings for password-reset emails are configured inside the app
# (Admin -> Settings), not here. Reset links always use APP_PUBLIC_ORIGIN.
